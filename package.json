{
  "name": "brightness_web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "echo 'No tests specified'",
    "format": "prettier --write \"**/*.{css,ts,tsx,html,json,md}\"",
    "format:css": "prettier --write \"**/*.css\"",
    "check": "prettier --check \"**/*.{css,ts,tsx,html,json,md}\"",
    "check:css": "prettier --check \"**/*.css\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.2",
    "@mui/system": "^7.3.2",
    "framer-motion": "^12.23.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "lint-staged": {
    "**/*.{css,ts,tsx,html,json,md}": "prettier --write"
  }
}
