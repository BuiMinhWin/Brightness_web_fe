  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 20px;
}

.footer-logo-image {
  width: 81px;
  height: 81px;
}

.footer-brand {
  color: white;
  font-family: 'Lexend Tera', sans-serif;
  font-size: 26px;
  font-weight: 600;
  letter-spacing: -2.34px;
  text-transform: capitalize;
}

.footer-contact {
  text-align: left;
}

.footer-contact-title {
  color: white;
  font-family: 'DM Sans', sans-serif;
  font-size: 20px;
  font-weight: 700;
  line-height: 18px;
  margin: 0 0 20px 0;
}

.footer-contact-item {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 15px;
}

.footer-contact-text {
  color: white;
  font-family: 'DM Sans', sans-serif;
  font-size: 16px;
  font-weight: 700;
  line-height: 18px;
}

.contact-icon {
  width: 25px;
  height: 25px;
  border: 2px solid white;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Homepage styles */
.homepage {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(352deg, rgba(91, 193, 127, 0.30) 10.49%, rgba(174, 255, 196, 0.30) 46.54%, rgba(0, 126, 133, 0.30) 80.3%);
  overflow-x: hidden;
}

/* Homepage header */
.homepage-header {
  background: #E0FFDF;
  padding: 24px 0;
  position: relative;
