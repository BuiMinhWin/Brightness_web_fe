* text=auto

# Use LF for source files to avoid shell/husky issues
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
.husky/* text eol=lf
*.sh     text eol=lf

# Keep Windows-native endings for Windows scripts
*.ps1    text eol=crlf
*.bat    text eol=crlf
